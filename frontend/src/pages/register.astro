---
import BaseLayout from '../layouts/BaseLayout.astro'
import BrandMark from '../components/BrandMark.astro'
---
<BaseLayout title="Crear cuenta | Hotel Gran Capital">
  <main class="grid min-h-screen place-items-center bg-[#f3f6fc] px-4 py-8"><section class="w-full max-w-[430px]"><div class="mb-6 flex justify-center"><BrandMark /></div><div class="soft-card p-7 sm:p-9"><div class="text-center"><span class="eyebrow">Portal de huéspedes</span><h1 class="mt-3 text-2xl font-black text-[#17243b]">Crea tu cuenta</h1><p class="mt-2 text-sm text-[#78849a]">Guarda tus reservas y gestiona tus próximas estancias.</p></div><div class="mt-7 grid grid-cols-2 rounded-lg bg-[#eaf0fb] p-1 text-center text-xs font-black"><a href="/login" class="px-3 py-2 text-[#6d7890]">Iniciar sesión</a><span class="rounded-md bg-white px-3 py-2 text-[#263651] shadow-sm">Registro de huésped</span></div><form id="register-form" class="mt-7 space-y-5" novalidate><div><label class="field-label" for="usuario">Usuario</label><input class="field" id="usuario" name="usuario" autocomplete="username" placeholder="Entre 1 y 15 caracteres" /></div><div><label class="field-label" for="contrasena">Contraseña</label><input class="field" id="contrasena" name="contrasena" type="password" autocomplete="new-password" placeholder="Mínimo 8 caracteres" /></div><div><label class="field-label" for="confirmacion">Repite la contraseña</label><input class="field" id="confirmacion" name="confirmacion" type="password" autocomplete="new-password" /></div><p id="form-error" class="hidden rounded-lg bg-[#fff0ef] p-3 text-xs font-bold text-[#b54545]"></p><p id="form-success" class="hidden rounded-lg bg-[#e8f8f1] p-3 text-xs font-bold text-[#168660]"></p><button class="btn-primary w-full" type="submit">Crear mi cuenta →</button></form></div></section></main>
  <script src="../scripts/register.ts"></script>
</BaseLayout>
