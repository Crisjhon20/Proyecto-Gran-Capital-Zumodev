---
import AppLayout from '../../layouts/AppLayout.astro'
---
<AppLayout title="Administrar habitaciones | Hotel Gran Capital">
  <section class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Gestión administrativa</p><h1 class="mt-2 text-3xl font-black tracking-tight text-[#17243b]">Actualizar habitación</h1><p class="mt-2 text-sm text-[#718097]">Selecciona una habitación para actualizar sus características.</p></div><a class="btn-secondary" href="/rooms">Ver listado público</a></section>
  <div class="mt-8 grid gap-6 lg:grid-cols-[.8fr_1.2fr]"><div class="soft-card p-5"><label class="field-label" for="room-select">Habitación</label><select id="room-select" class="field"><option value="">Cargando...</option></select><div id="room-preview" class="mt-5 text-sm text-[#718097]">Selecciona una habitación para editarla.</div></div><form id="room-edit-form" class="soft-card grid gap-4 p-6 sm:grid-cols-2" novalidate><div><label class="field-label" for="cama">Cama</label><select class="field" id="cama" name="cama"><option value="individual">Individual</option><option value="doble">Doble</option><option value="matrimonial">Matrimonial</option><option value="king">King</option></select></div><div><label class="field-label" for="precio">Precio por noche</label><input class="field" id="precio" name="precio" type="number" min="1" step="0.01" /></div><div><label class="field-label" for="disponibilidad">Disponibilidad</label><select class="field" id="disponibilidad" name="disponibilidad"><option value="disponible">Disponible</option><option value="no disponible">No disponible</option></select></div><div><label class="field-label" for="frigobar">Frigobar</label><select class="field" id="frigobar" name="frigobar"><option value="si">Sí</option><option value="no">No</option></select></div><div><label class="field-label" for="aire_acondicionado">Aire acondicionado</label><select class="field" id="aire_acondicionado" name="aire_acondicionado"><option value="si">Sí</option><option value="no">No</option></select></div><div><label class="field-label" for="televisor">Televisor</label><select class="field" id="televisor" name="televisor"><option value="si">Sí</option><option value="no">No</option></select></div><div><label class="field-label" for="bano_privado">Baño privado</label><select class="field" id="bano_privado" name="bano_privado"><option value="si">Sí</option><option value="no">No</option></select></div><div class="sm:col-span-2"><p id="form-error" class="hidden rounded-lg bg-[#fff0ef] p-3 text-xs font-bold text-[#b54545]"></p><p id="form-success" class="hidden rounded-lg bg-[#e8f8f1] p-3 text-xs font-bold text-[#168660]"></p></div><button class="btn-primary sm:col-span-2" type="submit">Guardar habitación →</button></form></div>
  <script src="../../scripts/edit-room.ts"></script>
</AppLayout>
