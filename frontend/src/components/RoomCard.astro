---
import type { Room } from '../types/room'
import { formatMoney } from '../utils/formatters'
const { room, showAction = true } = Astro.props as { room: Room; showAction?: boolean }
const features = [room.frigobar === 'si' ? 'Frigobar' : '', room.aire_acondicionado === 'si' ? 'Aire' : '', room.televisor === 'si' ? 'TV' : '', room.bano_privado === 'si' ? 'Baño privado' : ''].filter(Boolean)
---
<article class="soft-card overflow-hidden p-3">
  <div class="room-visual mb-4">
    <span class="absolute left-3 top-3 z-10 rounded-full bg-white/90 px-2 py-1 text-[9px] font-black uppercase tracking-wider text-[#263651]">Habitación {room.id_habitacion}</span>
    <span class={`absolute right-3 top-3 z-10 rounded-full px-2 py-1 text-[9px] font-black uppercase ${room.disponibilidad === 'disponible' ? 'bg-[#e8f8f1] text-[#168660]' : 'bg-[#fff0ef] text-[#b54545]'}`}>{room.disponibilidad}</span>
  </div>
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="text-[10px] font-black uppercase tracking-[.12em] text-[#a26922]">Cama {room.cama}</p>
      <h3 class="mt-1 text-lg font-black text-[#182640]">Estancia Gran Capital</h3>
      <p class="mt-2 text-xs text-[#738099]">{features.length ? features.join(' · ') : 'Estancia esencial y confortable'}</p>
    </div>
    <p class="text-right"><strong class="block text-xl font-black text-[#182640]">{formatMoney(room.precio)}</strong><small class="text-[10px] text-[#7c879b]">por noche</small></p>
  </div>
  {showAction && <a href={`/reservations/new?room=${room.id_habitacion}`} class={`mt-4 flex w-full items-center justify-center rounded-lg py-2.5 text-xs font-black ${room.disponibilidad === 'disponible' ? 'btn-primary' : 'pointer-events-none bg-[#edf1f7] text-[#9aa5b6]'}`}>{room.disponibilidad === 'disponible' ? 'Reservar habitación →' : 'No disponible'}</a>}
</article>
