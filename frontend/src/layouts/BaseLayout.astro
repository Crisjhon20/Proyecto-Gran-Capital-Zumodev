---
import '../styles/global.css'
const { title = 'Hotel Gran Capital', description = 'Estancias con carácter, servicio con precisión.' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
